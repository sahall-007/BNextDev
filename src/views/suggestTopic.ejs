<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suggest a New Topic</title>
    <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="bg-gray-50 min-h-screen py-8 px-4">
    <div class="max-w-3xl mx-auto">
        <!-- Back Button -->
        <a type="button" href="topicIntroduction.ejs" class="flex items-center text-gray-600 hover:text-gray-800 mb-6 transition">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to Topics
        </a>

        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Suggest a New Topic</h1>
            <p class="text-gray-600">Help the community by suggesting a valuable topic for mongodb</p>
        </div>

        <!-- Info Box -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
            <div class="flex">
                <svg class="w-5 h-5 text-blue-500 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <div>
                    <p class="font-semibold text-blue-900 mb-1">How Community Contributions Work</p>
                    <p class="text-blue-800 text-sm">Your suggestion will be reviewed by the community through voting. High-quality, relevant topics will rise to the top and help others in their learning journey!</p>
                </div>
            </div>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
            <form>
                <!-- Topic Title -->
                <div class="mb-6">
                    <label class="block text-gray-900 font-medium mb-2">
                        Topic Title <span class="text-red-500">*</span>
                    </label>
                    <input 
                        type="text" 
                        placeholder="e.g., Introduction to Components"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                    />
                    <p class="text-gray-500 text-sm mt-2">Clear and concise titles work best</p>
                </div>

                <!-- Description -->
                <div class="mb-6">
                    <label class="block text-gray-900 font-medium mb-2">
                        Description <span class="text-red-500">*</span>
                    </label>
                    <textarea 
                        rows="5"
                        placeholder="Explain what this topic covers and why it's important to learn..."
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition resize-none"
                    ></textarea>
                    <p class="text-gray-500 text-sm mt-2">Help learners understand the topic's value</p>
                </div>

                <!-- Complexity Level -->
                <div class="mb-6">
                    <label class="block text-gray-900 font-medium mb-2">
                        Complexity Level <span class="text-red-500">*</span>
                    </label>
                    <select class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition bg-white">
                        <option>Select complexity</option>
                        <option>Beginner</option>
                        <option>Intermediate</option>
                        <option>Advanced</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <button 
                        type="submit"
                        class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-md transition"
                    >
                        Submit Suggestion
                    </button>
                    <button 
                        type="button"
                        class="flex-1 bg-white hover:bg-gray-50 text-gray-700 font-medium py-3 px-6 rounded-md border border-gray-300 transition"
                    >
                        Cancel
                    </button>
                </div>
            </form>
        </div>

        <!-- Community Guidelines -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Community Guidelines</h2>
            <ul class="space-y-2">
                <li class="flex items-start">
                    <span class="text-red-500 mr-2">•</span>
                    <span class="text-gray-700">Ensure your topic is relevant to mongodb</span>
                </li>
                <li class="flex items-start">
                    <span class="text-red-500 mr-2">•</span>
                    <span class="text-gray-700">Check existing topics to avoid duplicates</span>
                </li>
                <li class="flex items-start">
                    <span class="text-red-500 mr-2">•</span>
                    <span class="text-gray-700">Provide clear, helpful descriptions for learners</span>
                </li>
                <li class="flex items-start">
                    <span class="text-red-500 mr-2">•</span>
                    <span class="text-gray-700">Rate complexity honestly to help others prioritize</span>
                </li>
            </ul>
        </div>
    </div>
</body>
</html>